{
  "cgui": 1,
  "root": {
    "kind": "element",
    "style": {
      "flex-direction": "column",
      "width": "220px",
      "gap": "8px 8px",
      "padding-top": "12px",
      "padding-right": "12px",
      "padding-bottom": "12px",
      "padding-left": "12px",
      "border-top-left-radius-x": "6px",
      "border-top-left-radius-y": "6px",
      "border-top-right-radius-x": "6px",
      "border-top-right-radius-y": "6px",
      "border-bottom-right-radius-x": "6px",
      "border-bottom-right-radius-y": "6px",
      "border-bottom-left-radius-x": "6px",
      "border-bottom-left-radius-y": "6px",
      "background-color": "#2B2D30"
    },
    "children": [
      {
        "kind": "text",
        "style": {
          "font-weight": "bold",
          "font-size": "13"
        },
        "state": {
          "text": "Delete world?"
        }
      },
      {
        "kind": "text",
        "state": {
          "text": "This cannot be undone."
        }
      },
      {
        "kind": "element",
        "style": {
          "flex-direction": "row",
          "align-items": "center",
          "gap": "4px 4px"
        },
        "children": [
          {
            "kind": "element",
            "style": {
              "flex-grow": "1"
            }
          },
          {
            "kind": "button",
            "state": {
              "text": "Cancel"
            }
          },
          {
            "kind": "button",
            "state": {
              "text": "Delete"
            }
          }
        ]
      }
    ]
  }
}
