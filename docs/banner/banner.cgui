{
  "cgui": 2,
  "stylesheets": [
    "banner.css"
  ],
  "root": {
    "kind": "element",
    "id": "root",
    "style": {
      "align-items": "center",
      "height": "1436px",
      "justify-content": "center",
      "padding-bottom": "60px",
      "padding-left": "60px",
      "padding-right": "60px",
      "padding-top": "60px"
    },
    "children": [
      {
        "kind": "element",
        "id": "stage",
        "style": {
          "height": "800px",
          "width": "1148px"
        },
        "children": [
          {
            "kind": "element",
            "id": "glow-teal",
            "style": {
              "background-image": "linear-gradient(to bottom right, #7CF5D0CC, #0F8F82CC)",
              "border-bottom-left-radius-x": "140px",
              "border-bottom-left-radius-y": "140px",
              "border-bottom-right-radius-x": "140px",
              "border-bottom-right-radius-y": "140px",
              "border-top-left-radius-x": "140px",
              "border-top-left-radius-y": "140px",
              "border-top-right-radius-x": "140px",
              "border-top-right-radius-y": "140px",
              "height": "280px",
              "left": "68px",
              "position": "absolute",
              "top": "76px",
              "width": "280px"
            }
          },
          {
            "kind": "element",
            "id": "glow-rose",
            "style": {
              "background-image": "linear-gradient(to bottom right, #5B2A86CC, #F472B6CC)",
              "border-bottom-left-radius-x": "140px",
              "border-bottom-left-radius-y": "140px",
              "border-bottom-right-radius-x": "140px",
              "border-bottom-right-radius-y": "140px",
              "border-top-left-radius-x": "140px",
              "border-top-left-radius-y": "140px",
              "border-top-right-radius-x": "140px",
              "border-top-right-radius-y": "140px",
              "height": "280px",
              "left": "814px",
              "position": "absolute",
              "top": "442px",
              "width": "280px"
            }
          },
          {
            "kind": "element",
            "id": "glow-violet",
            "style": {
              "background-image": "linear-gradient(to bottom right, #0F8F82, #CE3CD5)",
              "border-bottom-left-radius-x": "48px",
              "border-bottom-left-radius-y": "48px",
              "border-bottom-right-radius-x": "48px",
              "border-bottom-right-radius-y": "48px",
              "border-top-left-radius-x": "48px",
              "border-top-left-radius-y": "48px",
              "border-top-right-radius-x": "48px",
              "border-top-right-radius-y": "48px",
              "height": "96px",
              "left": "874px",
              "position": "absolute",
              "top": "112px",
              "transform": "translate(31.25786px, -3.8146973E-6px) scale(1.7553688, 1.7553688)",
              "transform-origin-x": "50.0%",
              "transform-origin-y": "50.0%",
              "width": "96px"
            }
          },
          {
            "kind": "element",
            "id": "card",
            "style": {
              "backdrop-filter": "blur(16px) saturate(1.2) tint(#FFFFFF1F) bezel(0px) specular(0.3) noise(0.05)",
              "background-color": "#FFFFFF1B",
              "border-bottom-left-radius-x": "44px",
              "border-bottom-left-radius-y": "44px",
              "border-bottom-right-radius-x": "44px",
              "border-bottom-right-radius-y": "44px",
              "border-top-left-radius-x": "44px",
              "border-top-left-radius-y": "44px",
              "border-top-right-radius-x": "44px",
              "border-top-right-radius-y": "44px",
              "flex-direction": "column",
              "gap": "28px 28px",
              "left": "284px",
              "outline-color": "#FFFFFF4D",
              "outline-width": "2px",
              "padding-bottom": "44px",
              "padding-left": "44px",
              "padding-right": "44px",
              "padding-top": "44px",
              "position": "absolute",
              "top": "132px",
              "width": "680px"
            },
            "children": [
              {
                "kind": "element",
                "id": "header",
                "style": {
                  "align-items": "center",
                  "flex-direction": "row",
                  "gap": "28px 28px"
                },
                "children": [
                  {
                    "kind": "element",
                    "id": "art",
                    "style": {
                      "background-image": "radial-gradient(circle 76.8px at 90% 95%, #FF6FB566, #FF6FB500), radial-gradient(circle 102.4px at 25% 15%, #B8FFE847, #B8FFE800), linear-gradient(to bottom right, #7CF5D0FF, #0F8F82FF 38%, #5B2A86FF 75%, #F472B6FF)",
                      "border-bottom-left-radius-x": "28px",
                      "border-bottom-left-radius-y": "28px",
                      "border-bottom-right-radius-x": "28px",
                      "border-bottom-right-radius-y": "28px",
                      "border-top-left-radius-x": "28px",
                      "border-top-left-radius-y": "28px",
                      "border-top-right-radius-x": "28px",
                      "border-top-right-radius-y": "28px",
                      "height": "128px",
                      "width": "128px"
                    }
                  },
                  {
                    "kind": "element",
                    "id": "track",
                    "style": {
                      "flex-direction": "column",
                      "gap": "8px 8px"
                    },
                    "children": [
                      {
                        "kind": "text",
                        "id": "title",
                        "style": {
                          "color": "#FFFFFF",
                          "font-size": "38px",
                          "font-weight": "bold",
                          "text-shadow": "/* #000000FF 0px 0px 5.6px 1.2px, */ 0px 0px 28px 5.2px #72F4DA99"
                        },
                        "state": {
                          "text": "Midnight Bloom"
                        }
                      },
                      {
                        "kind": "text",
                        "id": "artist",
                        "style": {
                          "color": "#C9B8F0",
                          "font-size": "24px"
                        },
                        "state": {
                          "text": "Crystal Lights \u00b7 Aurora EP"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "element",
                "id": "timeline",
                "style": {
                  "flex-direction": "column",
                  "gap": "12px 12px"
                },
                "children": [
                  {
                    "kind": "progressbar",
                    "id": "position",
                    "attrs": {
                      "hit-test": "false"
                    },
                    "style": {
                      "height": "10px",
                      "width": "100.0%"
                    },
                    "state": {
                      "fraction": 0.42
                    }
                  },
                  {
                    "kind": "element",
                    "id": "times",
                    "style": {
                      "flex-direction": "row",
                      "justify-content": "space-between"
                    },
                    "children": [
                      {
                        "kind": "text",
                        "style": {
                          "color": "#9C8FC4",
                          "font-size": "20px"
                        },
                        "state": {
                          "text": "1:42"
                        }
                      },
                      {
                        "kind": "text",
                        "style": {
                          "color": "#9C8FC4",
                          "font-size": "20px"
                        },
                        "state": {
                          "text": "4:05"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "element",
                "id": "shuffle-row",
                "style": {
                  "align-items": "center",
                  "flex-direction": "row",
                  "justify-content": "space-between"
                },
                "children": [
                  {
                    "kind": "text",
                    "style": {
                      "color": "#E7EEF8",
                      "font-size": "26px"
                    },
                    "state": {
                      "text": "Shuffle"
                    }
                  },
                  {
                    "kind": "switch",
                    "id": "shuffle",
                    "attrs": {
                      "focus-policy": "CLICK"
                    },
                    "state": {
                      "checked": true
                    }
                  }
                ]
              },
              {
                "kind": "element",
                "id": "volume-row",
                "style": {
                  "align-items": "center",
                  "flex-direction": "row",
                  "justify-content": "space-between"
                },
                "children": [
                  {
                    "kind": "text",
                    "style": {
                      "color": "#E7EEF8",
                      "font-size": "26px"
                    },
                    "state": {
                      "text": "Volume"
                    }
                  },
                  {
                    "kind": "slider",
                    "id": "volume",
                    "attrs": {
                      "focus-policy": "CLICK"
                    },
                    "style": {
                      "width": "320px"
                    },
                    "state": {
                      "min": 0.0,
                      "max": 1.0,
                      "step": 0.0,
                      "value": 0.7
                    }
                  }
                ]
              },
              {
                "kind": "button",
                "id": "play",
                "attrs": {
                  "focus-policy": "CLICK"
                },
                "style": {
                  "background-image": "linear-gradient(90deg, #7CF5D0, #0F8F82 38%, #5B2A86 75%, #F472B6)",
                  "border-bottom-left-radius-x": "24px",
                  "border-bottom-left-radius-y": "24px",
                  "border-bottom-right-radius-x": "24px",
                  "border-bottom-right-radius-y": "24px",
                  "border-bottom-width": "0px",
                  "border-left-width": "0px",
                  "border-right-width": "0px",
                  "border-top-left-radius-x": "24px",
                  "border-top-left-radius-y": "24px",
                  "border-top-right-radius-x": "24px",
                  "border-top-right-radius-y": "24px",
                  "border-top-width": "0px",
                  "color": "#FFFFFF",
                  "font-size": "28px",
                  "font-weight": "bold",
                  "height": "76px",
                  "text-shadow": "#00000055 0px 2px 4px",
                  "width": "100.0%"
                },
                "state": {
                  "text": "Play"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
