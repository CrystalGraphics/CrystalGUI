                  "border-bottom-width": "0.0px",
                  "border-left-width": "0.0px",
                  "border-right-width": "0.0px",
                  "border-top-left-radius-x": "12.0px",
                  "border-top-left-radius-y": "12.0px",
                  "border-top-right-radius-x": "12.0px",
                  "border-top-right-radius-y": "12.0px",
                  "border-top-width": "0.0px",
                  "color": "#FFFFFF",
                  "font-size": "14.0",
                  "font-weight": "bold",
                  "height": "38.0px",
                  "text-shadow": "#00000055 0px 1px 2px",
                  "width": "100.0%"
                },
                "state": {
                  "text": "Play"
