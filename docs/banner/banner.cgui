                      "background": "radial-gradient(circle 38.4px at 90% 95%, #FF6FB566, #FF6FB500), radial-gradient(circle 51.2px at 25% 15%, #B8FFE847, #B8FFE800), linear-gradient(to bottom right, #7CF5D0FF, #0F8F82FF 38%, #5B2A86FF 75%, #F472B6FF)",
                      "border-bottom-left-radius-x": "14.0px",
                      "border-bottom-left-radius-y": "14.0px",
                      "border-bottom-right-radius-x": "14.0px",
                      "border-bottom-right-radius-y": "14.0px",
                      "border-top-left-radius-x": "14.0px",
                      "border-top-left-radius-y": "14.0px",
                      "border-top-right-radius-x": "14.0px",
                      "border-top-right-radius-y": "14.0px",
                      "height": "64.0px",
                      "width": "64.0px"
