                        },
                        "state": {
                          "text": "Midnight Bloom"
                        }
                      },
                      {
                        "kind": "text",
                        "id": "artist",
                        "style": {
                          "color": "#C9B8F0",
                          "font-size": "12.0"
                        },
                        "state": {
                          "text": "Crystal Lights · Aurora EP"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "element",
                "id": "timeline",
                "style": {
                  "flex-direction": "column",
                  "gap": "6px 6px"
                },
                "children": [
                  {
                    "kind": "progressbar",
                    "id": "position",
                    "attrs": {
                      "hit-test": "false"
                    },
                    "style": {
                      "height": "5.0px",
                      "width": "100.0%"
                    },
                    "state": {
                      "fraction": 0.42
                    }
                  },
                  {
                    "kind": "element",
                    "id": "times",
                    "style": {
                      "flex-direction": "row",
                      "justify-content": "space-between"
                    },
                    "children": [
                      {
                        "kind": "text",
                        "style": {
                          "color": "#9C8FC4",
                          "font-size": "10.0"
                        },
                        "state": {
                          "text": "1:42"
                        }
                      },
                      {
                        "kind": "text",
                        "style": {
                          "color": "#9C8FC4",
                          "font-size": "10.0"
                        },
                        "state": {
                          "text": "4:05"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "element",
                "id": "shuffle-row",
                "style": {
                  "align-items": "center",
                  "flex-direction": "row",
                  "justify-content": "space-between"
                },
                "children": [
                  {
                    "kind": "text",
                    "style": {
                      "color": "#E7EEF8",
                      "font-size": "13.0"
                    },
                    "state": {
                      "text": "Shuffle"
                    }
                  },
                  {
                    "kind": "switch",
                    "id": "shuffle",
                    "attrs": {
                      "focus-policy": "CLICK"
                    },
                    "state": {
                      "checked": true
                    }
                  }
                ]
              },
              {
                "kind": "element",
                "id": "volume-row",
                "style": {
                  "align-items": "center",
                  "flex-direction": "row",
                  "justify-content": "space-between"
                },
                "children": [
                  {
                    "kind": "text",
                    "style": {
                      "color": "#E7EEF8",
                      "font-size": "13.0"
                    },
                    "state": {
                      "text": "Volume"
                    }
                  },
                  {
                    "kind": "slider",
                    "id": "volume",
                    "attrs": {
                      "focus-policy": "CLICK"
                    },
                    "style": {
                      "width": "160.0px"
                    },
                    "state": {
                      "min": 0.0,
                      "max": 1.0,
                      "step": 0.0,
                      "value": 0.7
                    }
                  }
                ]
              },
              {
                "kind": "button",
                "id": "play",
                "attrs": {
                  "focus-policy": "CLICK"
